# Copy to .env and edit. Never commit .env (RFC v3 §7).

# Where the SQLite database, the imports folder and backups live when PROJECTBUDGET_DATABASE_URL is unset.
# PROJECTBUDGET_DATA_DIR=~/.projectbudget

# SQLAlchemy URL. Only sqlite and postgresql are supported (ADR-001).
# PROJECTBUDGET_DATABASE_URL=sqlite+pysqlite:////data/projectbudget.sqlite
# PROJECTBUDGET_DATABASE_URL=postgresql+psycopg://projectbudget@localhost:5432/projectbudget

# Optional: database password kept out of the URL (no URL-encoding needed; overrides any password in the URL).
# PROJECTBUDGET_DATABASE_PASSWORD=

# HTTP server bind address.
# PROJECTBUDGET_HOST=127.0.0.1
# PROJECTBUDGET_PORT=8000

# Session cookie: Secure by default (browsers accept it from localhost). Only set false for plain HTTP on a trusted network.
# PROJECTBUDGET_SECURE_COOKIES=true
# Log out after this long without a request (minutes). Default: 7 days.
# PROJECTBUDGET_SESSION_IDLE_TIMEOUT_MINUTES=10080

# Directory that file and CSV sync sources may read from (ADR-007). Default: <data dir>/imports.
# PROJECTBUDGET_SYNC_IMPORT_DIR=/data/imports

# Optional: one fine-grained read-only GitHub token for private sync sources (docs/operations.md, "GitHub tokens").
# A source's own token variable overrides it. Never commit a real value.
# PROJECTBUDGET_GITHUB_TOKEN=

# Used only by compose.yaml for the PostgreSQL container and the app's connection string.
POSTGRES_PASSWORD=
